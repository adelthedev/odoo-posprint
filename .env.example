# Copy to .env and adjust per environment.
#
# Dev (Mac): keep the defaults below and enable the emulator profile:
#   docker compose --profile dev up -d
# Prod (WSL): set the real printer IPs and do NOT enable the dev profile.

# Raw ESC/POS printer endpoints. The cups container creates one queue per
# PRINTER_<NAME>_URI variable, named <name> lowercased — so the two below give
# queues `receipt` and `kitchen`, and e.g. PRINTER_BAR_URI would add a `bar`
# queue. Add as many as you have printers; removing a variable does NOT delete
# its queue (drop it in the CUPS web UI or with `lpadmin -x <queue>`).
PRINTER_RECEIPT_URI=socket://escpos-emulator:9100
PRINTER_KITCHEN_URI=socket://escpos-emulator:9100

# Host port for the CUPS web UI (http://localhost:<port>). 631 clashes with
# macOS's own cupsd on dev Macs, hence the 6631 default.
#CUPS_WEB_PORT=6631

# Prod example:
# PRINTER_RECEIPT_URI=socket://192.168.1.50:9100
# PRINTER_KITCHEN_URI=socket://192.168.1.51:9100
# PRINTER_BAR_URI=socket://192.168.1.52:9100
